{
  "expo": {
    "name": "Mentally Prepare",
    "slug": "mentally-prepare",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mentallyprepare",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050311",
    "android": {
      "package": "com.mentallyprepare.app",
      "adaptiveIcon": {
        "backgroundColor": "#050311",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.mentallyprepare.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050311",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7457c18a-bff3-493c-b7e8-057ded0c3a19"
      }
    },
    "owner": "aashi12"
  }
}
