{
  "name": "mentally-prepare-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/start-web-preview.js",
    "preview:api": "node scripts/dev-api-proxy.js",
    "build": "npm run build:web",
    "build:web": "expo export --platform web --output-dir dist",
    "brand:generate": "node scripts/generate-brand-assets.js",
    "brand:check": "node scripts/generate-brand-assets.js --check",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:api": "node test/client.test.js",
    "test:sky": "node test/sky.test.js",
    "test": "npm run test:api && npm run test:sky && npm run test:daily && npm run test:quiz && npm run test:notifications && npm run test:safety && npm run test:password-reset && npm run test:sign-up && npm run test:providers && npm run test:load-state && npm run test:keyboard && npm run test:drafts && npm run test:contrast && npm run test:font-gate && npm run test:support && npm run test:deployment && npm run test:profile && npm run test:readiness && npm run test:error-boundary && npm run test:parse && npm run test:rematch && npm run test:i18n",
    "test:daily": "node test/daily-edition.test.js",
    "test:quiz": "node test/quiz.test.js",
    "test:notifications": "node test/notifications.test.js",
    "test:safety": "node test/safety.test.js",
    "test:password-reset": "node test/password-reset.test.js",
    "test:sign-up": "node test/sign-up.test.js",
    "test:providers": "node test/provider-layout.test.js",
    "test:deployment": "node test/deployment.test.js",
    "test:profile": "node test/profile-scene.test.js",
    "test:load-state": "node test/load-state.test.js",
    "test:keyboard": "node test/keyboard-clearance.test.js",
    "test:drafts": "node test/drafts.test.js",
    "test:readiness": "node test/production-readiness.test.js",
    "test:contrast": "node test/contrast.test.js",
    "test:font-gate": "node test/font-gate.test.js",
    "test:error-boundary": "node test/error-boundary.test.js",
    "test:parse": "node test/parse.test.js",
    "test:rematch": "node test/rematch.test.js",
    "test:i18n": "node test/i18n.test.js",
    "test:support": "node test/support.test.js"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.0",
    "@expo-google-fonts/manrope": "^0.4.0",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "sharp": "0.35.3",
    "typescript": "~6.0.3"
