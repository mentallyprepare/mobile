{
  "name": "mentally-prepare-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:web": "expo export --platform web --output-dir dist",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:api": "node test/client.test.js",
    "test:sky": "node test/sky.test.js",
    "test": "npm run test:api && npm run test:sky"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.0",
    "@expo-google-fonts/manrope": "^0.4.0",
    "expo": "~56.0.11",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.6",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  }
}
